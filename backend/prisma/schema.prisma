generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id                     String                    @id @default(cuid())
  name                   String
  email                  String                    @unique
  phone                  String?
  address                String?
  userId                 String?                   @unique @map("userid")
  createdAt              DateTime                  @default(now()) @map("createdat")
  updatedAt              DateTime                  @updatedAt @map("updatedat")
  user                   User?                     @relation(fields: [userId], references: [id])
  licenses               License[]
  biDashboards           BiDashboard[]
  biNotifications        BiNotification[]
  biAnalysisRequests     BiAnalysisRequest[]
  biRequests             BiRequest[]
  biDashboardAssignments BiDashboardAssignment[]

  @@map("clients")
}

model License {
  id                   String                     @id @default(cuid())
  clientId             String                     @map("clientid")
  licenseKey           String                     @unique @map("licensekey")
  sector               String
  licenseType          LicenseType                @map("licensetype")
  expirationDate       DateTime?                  @map("expirationdate")
  isActive             Boolean                    @default(true) @map("isactive")
  machineId            String?                    @map("machineid")
  buildStatus          String?                    @default("pending") @map("buildstatus")
  buildProjectPath     String?                    @map("buildprojectpath")
  buildProjectName     String?                    @map("buildprojectname")
  buildRunId           String?                    @map("buildrunid")
  bindingType          String                     @default("MACHINE") @map("bindingtype")
  usbSerialNumber      String?                    @map("usbserialnumber")
  isActivated          Boolean                    @default(false) @map("isactivated")
  activatedAt          DateTime?                  @map("activatedat")
  lastValidatedAt      DateTime?                  @map("lastvalidatedat")
  createdBy            String?                    @default("admin") @map("createdby")
  status               LicenseStatus              @default(CREATED)
  legacy               Boolean                    @default(false)
  licenseVersion       Int                        @default(1) @map("licenseversion")
  machineFingerprint   String?                    @map("machinefingerprint")
  activatedMachineId   String?                    @map("activatedmachineid")
  usbDeviceId          String?                    @map("usbdeviceid")
  activationCount      Int                        @default(0) @map("activationcount")
  transferCount        Int                        @default(0) @map("transfercount")
  maxTransfers         Int                        @default(3) @map("maxtransfers")
  issuedAt             DateTime?                  @map("issuedat")
  suspendedAt          DateTime?                  @map("suspendedat")
  revokedAt            DateTime?                  @map("revokedat")
  renewedAt            DateTime?                  @map("renewedat")
  replacedAt           DateTime?                  @map("replacedat")
  replacedById         String?                    @map("replacedbyid")
  signature            String?
  signedLicensePayload Json?                      @map("signedlicensepayload")
  publicKeyFingerprint String?                    @map("publickeyfingerprint")
  lastValidationResult String?                    @map("lastvalidationresult")
  createdAt            DateTime                   @default(now()) @map("createdat")
  updatedAt            DateTime                   @updatedAt @map("updatedat")
  UserPosConfiguration UserPosConfiguration?
  configuration        LicenseConfiguration?
  modules              LicenseModule[]
  client               Client                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  biDashboards         BiDashboard[]
  biAnalysisRequests   BiAnalysisRequest[]
  biRequests           BiRequest[]
  activationHistories  LicenseActivationHistory[]
  validationLogs       LicenseValidationLog[]
  transferHistories    LicenseTransferHistory[]

  @@map("licenses")
}

model LicenseActivationHistory {
  id          String         @id @default(cuid())
  licenseId   String         @map("licenseid")
  action      String
  fromStatus  LicenseStatus? @map("fromstatus")
  toStatus    LicenseStatus? @map("tostatus")
  details     Json?
  performedBy String?        @map("performedby")
  performedAt DateTime       @default(now()) @map("performedat")
  createdAt   DateTime       @default(now()) @map("createdat")
  license     License        @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@map("license_activation_histories")
}

model LicenseValidationLog {
  id          String                @id @default(cuid())
  licenseId   String                @map("licenseid")
  isValid     Boolean               @map("isvalid")
  reason      LicenseFailureReason?
  status      String?
  details     Json?
  validatedAt DateTime              @default(now()) @map("validatedat")
  createdAt   DateTime              @default(now()) @map("createdat")
  license     License               @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@index([validatedAt])
  @@map("license_validation_logs")
}

model LicenseTransferHistory {
  id                      String   @id @default(cuid())
  licenseId               String   @map("licenseid")
  transferType            String   @map("transfertype")
  fromMachineFingerprint  String?  @map("frommachinefingerprint")
  toMachineFingerprint    String?  @map("tomachinefingerprint")
  fromUsbDeviceId         String?  @map("fromusbdeviceid")
  toUsbDeviceId           String?  @map("tousbdeviceid")
  authorizedBy            String?  @map("authorizedby")
  authorizedAt            DateTime @default(now()) @map("authorizedat")
  details                 Json?
  createdAt               DateTime @default(now()) @map("createdat")
  license                 License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@map("license_transfer_histories")
}

model Module {
  id             String          @id @default(cuid())
  name           String          @unique
  displayName    String          @map("displayname")
  description    String?
  category       String
  isCore         Boolean         @default(false) @map("iscore")
  createdAt      DateTime        @default(now()) @map("createdat")
  updatedAt      DateTime        @updatedAt @map("updatedat")
  licenseModules LicenseModule[]

  @@map("modules")
}

model LicenseModule {
  id        String  @id @default(cuid())
  licenseId String  @map("licenseid")
  moduleId  String  @map("moduleid")
  isEnabled Boolean @default(true) @map("isenabled")
  license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([licenseId, moduleId])
  @@map("license_modules")
}

model LicenseConfiguration {
  id                  String  @id @default(cuid())
  licenseId           String  @unique @map("licenseid")
  businessName        String  @map("businessname")
  logo                String?
  primaryColor        String  @default("#3B82F6") @map("primarycolor")
  secondaryColor      String  @default("#1E40AF") @map("secondarycolor")
  accentColor         String  @default("#F59E0B") @map("accentcolor")
  backgroundColor     String  @default("#FFFFFF") @map("backgroundcolor")
  textColor           String  @default("#1F2937") @map("textcolor")
  currency            String  @default("EUR")
  taxRate             Float   @default(20.0) @map("taxrate")
  language            String  @default("fr")
  timezone            String  @default("Europe/Paris")
  borderRadius        String  @default("medium") @map("borderradius")
  fontFamily          String  @default("Inter") @map("fontfamily")
  navbarPosition      String? @map("navbarposition")
  animations          Boolean @default(true)
  brandWatermark      Boolean @default(false) @map("brandwatermark")
  buttonStyle         String  @default("filled") @map("buttonstyle")
  cardBackgroundColor String  @default("#FFFFFF") @map("cardbackgroundcolor")
  cardStyle           String  @default("modern") @map("cardstyle")
  compactMode         Boolean @default(false) @map("compactmode")
  customCSS           String? @map("customcss")
  dashboardLayout     String  @default("grid") @map("dashboardlayout")
  favicon             String?
  fontSize            String  @default("14px") @map("fontsize")
  fontWeight          String  @default("normal") @map("fontweight")
  glassEffect         Boolean @default(false) @map("glasseffect")
  gradientBackgrounds Boolean @default(false) @map("gradientbackgrounds")
  highContrastMode    Boolean @default(false) @map("highcontrastmode")
  hoverEffects        String  @default("subtle") @map("hovereffects")
  largeTextMode       Boolean @default(false) @map("largetextmode")
  modalStyle          String  @default("centered") @map("modalstyle")
  navbarCollapsible   Boolean @default(false) @map("navbarcollapsible")
  navbarStyle         String  @default("modern") @map("navbarstyle")
  reducedMotion       Boolean @default(false) @map("reducedmotion")
  responsiveMode      String  @default("auto") @map("responsivemode")
  showBreadcrumbs     Boolean @default(true) @map("showbreadcrumbs")
  showModuleBadges    Boolean @default(true) @map("showmodulebadges")
  showModuleIcons     Boolean @default(true) @map("showmoduleicons")
  showQuickActions    Boolean @default(true) @map("showquickactions")
  splashScreen        Boolean @default(false) @map("splashscreen")
  tableStyle          String  @default("modern") @map("tablestyle")
  textMutedColor      String  @default("#6B7280") @map("textmutedcolor")
  widgetSizes         String  @default("mixed") @map("widgetsizes")
  appTitle            String? @map("apptitle")
  autoModeSwitch      Boolean @default(false) @map("automodeswitch")
  autoSave            Boolean @default(true) @map("autosave")
  backdropBlur        Boolean @default(false) @map("backdropblur")
  borderColor         String  @default("#E5E7EB") @map("bordercolor")
  maxWidth            String  @default("1200px") @map("maxwidth")
  opacity             Float   @default(1.0)
  shadows             Boolean @default(true)
  spacingScale        Float   @default(1.0) @map("spacingscale")
  theme               String  @default("light")
  shadowIntensity     Float   @default(1.0) @map("shadowintensity")
  rawConfig           Json?   @map("rawconfig")
  posConfigVersion    Int     @default(1) @map("posconfigversion")
  license             License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@map("license_configurations")
}

model User {
  id                   String                 @id @default(cuid())
  username             String                 @unique
  email                String                 @unique
  password             String
  role                 UserRole               @default(CLIENT)
  isActive             Boolean                @default(true) @map("isactive")
  lastLogin            DateTime?              @map("lastlogin")
  createdAt            DateTime               @default(now()) @map("createdat")
  updatedAt            DateTime               @updatedAt @map("updatedat")
  accountType          AccountType            @default(NORMAL) @map("accounttype")
  affiliateCode        String?                @unique @map("affiliatecode")
  businessInfo         Json?                  @map("businessinfo")
  documents            String[]               @default([])
  pendingCommissions   Float                  @default(0) @map("pendingcommissions")
  referredBy           String?                @map("referredby")
  rejectionReason      String?                @map("rejectionreason")
  totalCommissions     Float                  @default(0) @map("totalcommissions")
  totalReferrals       Int                    @default(0) @map("totalreferrals")
  verificationStatus   VerificationStatus     @default(PENDING) @map("verificationstatus")
  verifiedAt           DateTime?              @map("verifiedat")
  client               Client?
  UserPosConfiguration UserPosConfiguration[]
  orders               Order[]
  affiliateOwner       Referral[]             @relation("AffiliateOwner")
  referrals            Referral[]             @relation("UserReferrals")
  userPermissions      UserPermission[]

  @@map("users")
}

// ──────────────────────────────────────────────
// RBAC — Granular permissions (admin dashboard)
// ──────────────────────────────────────────────

model Permission {
  id               String           @id @default(cuid())
  key              String           @unique
  module           String
  name             String
  description      String?
  createdAt        DateTime         @default(now()) @map("createdat")
  updatedAt        DateTime         @updatedAt @map("updatedat")
  userPermissions  UserPermission[]

  // NB: mapped to "app_permissions" (not "permissions") because the shared
  // Postgres database already contains a Metabase-owned "permissions" table.
  @@map("app_permissions")
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String     @map("userid")
  permissionId String     @map("permissionid")
  createdAt    DateTime   @default(now()) @map("createdat")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@map("user_permissions")
}

model Referral {
  id               String         @id @default(cuid())
  affiliateUserId  String         @map("affiliateuserid")
  referredUserId   String         @map("referreduserid")
  purchaseAmount   Float          @map("purchaseamount")
  commissionRate   Float          @map("commissionrate")
  commissionAmount Float          @map("commissionamount")
  status           ReferralStatus @default(PENDING)
  paidAt           DateTime?      @map("paidat")
  createdAt        DateTime       @default(now()) @map("createdat")
  updatedAt        DateTime       @updatedAt @map("updatedat")
  affiliateUser    User           @relation("AffiliateOwner", fields: [affiliateUserId], references: [id])
  referredUser     User           @relation("UserReferrals", fields: [referredUserId], references: [id])

  @@map("referrals")
}

model Customer {
  id                  String               @id @default(cuid())
  name                String
  email               String?              @unique
  phone               String?
  address             String?
  loyaltyPoints       Int                  @default(0) @map("loyaltypoints")
  createdAt           DateTime             @default(now()) @map("createdat")
  updatedAt           DateTime             @updatedAt @map("updatedat")
  appointments        Appointment[]
  loyaltyTransactions LoyaltyTransaction[]
  orders              Order[]

  @@map("customers")
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Float
  category    String
  barcode     String?     @unique
  stock       Int         @default(0)
  isActive    Boolean     @default(true) @map("isactive")
  createdAt   DateTime    @default(now()) @map("createdat")
  updatedAt   DateTime    @updatedAt @map("updatedat")
  orderItems  OrderItem[]

  @@map("products")
}

model Order {
  id                  String      @id @default(cuid())
  customerId          String?     @map("customerid")
  userId              String?     @map("userid")
  orderType           OrderType   @default(DINE_IN) @map("ordertype")
  status              OrderStatus @default(PENDING)
  total               Float
  tableNumber         Int?        @map("tablenumber")
  pickupTime          DateTime?   @map("pickuptime")
  deliveryAddress     String?     @map("deliveryaddress")
  specialInstructions String?     @map("specialinstructions")
  preparationTime     Int?        @map("preparationtime")
  createdAt           DateTime    @default(now()) @map("createdat")
  updatedAt           DateTime    @updatedAt @map("updatedat")
  orderItems          OrderItem[]
  customer            Customer?   @relation(fields: [customerId], references: [id])
  user                User?       @relation(fields: [userId], references: [id])

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("orderid")
  productId String  @map("productid")
  quantity  Int
  unitPrice Float   @map("unitprice")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model LoyaltyTransaction {
  id         String                 @id @default(cuid())
  customerId String                 @map("customerid")
  points     Int
  type       LoyaltyTransactionType
  reason     String?
  createdAt  DateTime               @default(now()) @map("createdat")
  customer   Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("loyalty_transactions")
}

model GiftCard {
  id            String    @id @default(cuid())
  code          String    @unique
  originalValue Float     @map("originalvalue")
  currentValue  Float     @map("currentvalue")
  isActive      Boolean   @default(true) @map("isactive")
  expiryDate    DateTime? @map("expirydate")
  createdAt     DateTime  @default(now()) @map("createdat")
  updatedAt     DateTime  @updatedAt @map("updatedat")

  @@map("gift_cards")
}

model Table {
  id       String  @id @default(cuid())
  number   Int     @unique
  capacity Int
  isActive Boolean @default(true) @map("isactive")
  x        Float?
  y        Float?

  @@map("tables")
}

model Appointment {
  id              String    @id @default(cuid())
  customerId      String?   @map("customerid")
  customerName    String    @map("customername")
  customerPhone   String?   @map("customerphone")
  customerEmail   String?   @map("customeremail")
  serviceType     String    @map("servicetype")
  appointmentDate DateTime  @map("appointmentdate")
  duration        Int
  notes           String?
  status          String    @default("SCHEDULED")
  createdAt       DateTime  @default(now()) @map("createdat")
  updatedAt       DateTime  @updatedAt @map("updatedat")
  customer        Customer? @relation(fields: [customerId], references: [id])

  @@map("appointments")
}

model UserPosConfiguration {
  id           String    @id
  userId       String    @map("userid")
  licenseId    String    @unique @map("licenseid")
  businessName String    @map("businessname")
  sector       String
  outputPath   String?   @map("outputpath")
  buildStatus  String    @default("idle") @map("buildstatus")
  lastBuiltAt  DateTime? @map("lastbuiltat")
  createdAt    DateTime  @default(now()) @map("createdat")
  updatedAt    DateTime  @map("updatedat")
  licenses     License   @relation(fields: [licenseId], references: [id])
  users        User      @relation(fields: [userId], references: [id])
}

// ──────────────────────────────────────────────
// BI Dashboards & Notifications (Phase 2)
// ──────────────────────────────────────────────

model BiDashboard {
  id              String    @id @default(cuid())
  clientId        String    @map("clientid")
  licenseId       String?   @map("licenseid")
  uploadId        String?   @map("uploadid")
  businessType    String    @map("businesstype")
  name            String
  description     String?
  status          String    @default("DRAFT")
  dashboardType   String    @default("custom") @map("dashboardtype")
  dashboardConfig Json?     @map("dashboardconfig")
  version         Int       @default(1)
  templateUsed    String?   @map("templateused")
  metabaseDashboardId Int?  @map("metabasedashboardid")
  generator       String    @default("wizard")
  generatedAt     DateTime? @map("generatedat")
  createdBy       String?   @map("createdby")
  assignedAt      DateTime? @map("assignedat")
  createdAt       DateTime  @default(now()) @map("createdat")
  updatedAt       DateTime  @updatedAt @map("updatedat")

  client        Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  license       License?                  @relation(fields: [licenseId], references: [id])
  upload        BiUpload?                 @relation(fields: [uploadId], references: [id])
  request       BiRequest?                @relation(fields: [requestId], references: [id], onDelete: SetNull)
  requestId     String?                   @map("requestid")
  notifications BiNotification[]
  assignments   BiDashboardAssignment[]

  @@index([clientId])
  @@index([uploadId])
  @@index([requestId])
  @@map("bi_dashboards")
}

model BiDashboardAssignment {
  id          String      @id @default(cuid())
  clientId    String      @map("clientid")
  dashboardId String      @map("dashboardid")
  version     Int         @default(1)
  status      String      @default("ACTIVE")
  assignedAt  DateTime    @default(now()) @map("assignedat")
  createdAt   DateTime    @default(now()) @map("createdat")

  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dashboard BiDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([dashboardId])
  @@map("bi_dashboard_assignments")
}

// ─── Metabase Dashboard Template Registry ──────────────────

model BiDashboardTemplate {
  id                  String   @id @default(cuid())
  businessType        String   @unique @map("businesstype")
  metabaseDashboardId Int      @map("metabasedashboardid")
  name                String
  description         String?
  kpis                Json?
  dimensions          Json?
  facts               Json?
  image               String?
  active              Boolean  @default(true)
  embedType           String   @map("embedtype") @default("none")
  embedPublicUuid     String?  @map("embedpublicuuid")
  createdAt           DateTime @map("createdat") @default(now())
  updatedAt           DateTime @map("updatedat") @updatedAt

  @@map("bi_dashboard_templates")
}

model BiNotification {
  id          String   @id @default(cuid())
  clientId    String?  @map("clientid")
  requestId   String?  @map("requestid")
  dashboardId String?  @map("dashboardid")
  title       String
  message     String
  type        String   @default("DASHBOARD_READY")
  category    String   @default("SYSTEM")
  role        String   @default("CLIENT")
  isRead      Boolean  @default(false) @map("isread")
  createdAt   DateTime @default(now()) @map("createdat")

  client    Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  request   BiRequest?   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  dashboard BiDashboard? @relation(fields: [dashboardId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([requestId])
  @@index([role])
  @@index([category])
  @@map("bi_notifications")
}

// ──────────────────────────────────────────────
// BI Analysis Requests (Phase 3)
// ──────────────────────────────────────────────

model BiAnalysisRequest {
  id              String    @id @default(cuid())
  clientId        String    @map("clientid")
  licenseId       String?   @map("licenseid")
  uploadId        String?   @map("uploadid")
  businessType    String    @map("businesstype")
  status          String    @default("PENDING")
  assignedTo      String?   @map("assignedto")
  notes           String?
  analysisSummary Json?     @map("analysissummary")
  insights        Json?
  createdAt       DateTime  @default(now()) @map("createdat")
  updatedAt       DateTime  @updatedAt @map("updatedat")
  completedAt     DateTime? @map("completedat")

  client  Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  license License?  @relation(fields: [licenseId], references: [id])
  upload  BiUpload? @relation(fields: [uploadId], references: [id])

  @@index([clientId])
  @@index([status])
  @@map("bi_analysis_requests")
}

// ──────────────────────────────────────────────
// BI Requests (Phase 1 — client submissions)
// ──────────────────────────────────────────────

model BiRequest {
  id        String  @id @default(cuid())
  clientId  String  @map("clientid")
  licenseId String? @map("licenseid")

  businessType String  @map("businesstype")
  businessName String? @map("businessname")

  message String

  objectives Json?
  kpis       Json?

  dashboardRequirements String? @map("dashboardrequirements")

  dashboardType String? @map("dashboardtype")

  dashboardTemplate String? @map("dashboardtemplate")
  paymentRequired   Boolean @default(false) @map("paymentrequired")

  userId    String? @map("userid")
  userEmail String? @map("useremail")

  status String @default("PENDING_REVIEW")

  paymentStatus String @default("NOT_REQUIRED")
  paymentMethod String? @map("paymentmethod")
  paymentNotes  String? @map("paymentnotes")

  adminNotes      String? @map("adminnotes")
  specialistNotes String? @default("")

  files Json? @default("[]")

  createdAt DateTime @default(now()) @map("createdat")
  updatedAt DateTime @updatedAt @map("updatedat")

  client     Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  license    License?         @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  uploads    BiUpload[]
  events     BiRequestEvent[]
  dashboards BiDashboard[]
  notifications BiNotification[]

  @@index([clientId])
  @@index([licenseId])
  @@index([status])
  @@index([paymentStatus])
  @@map("bi_requests")
}

model BiRequestEvent {
  id              String    @id @default(cuid())
  requestId       String    @map("requestid")
  type            String
  message         String?
  metadata        Json?
  performedBy     String?   @map("performedby")
  performedByRole String?   @map("performedbyrole")
  performedAt     DateTime  @map("performedat")
  createdAt       DateTime  @default(now()) @map("createdat")

  request BiRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("bi_request_events")
}

// ──────────────────────────────────────────────
// BI Upload & ETL Tracking
// ──────────────────────────────────────────────

model BiUpload {
  id               String              @id @default(cuid())
  clientId         String?             @map("clientid")
  requestId        String?             @map("requestid")
  businessType     String?             @map("businesstype")
  businessName     String?             @map("businessname")
  biSchemaVersion  String?             @map("bischemaversion")
  fileHash         String?             @unique @map("filehash")
  fileName         String?             @map("filename")
  fileSize         Int?                @map("filesize")
  filePath         String?             @map("filepath")
  status           String              @default("UPLOADED")
  totalFiles       Int                 @default(0) @map("totalfiles")
  totalRows        Int                 @default(0) @map("totalrows")
  errorMessage     String?             @map("errormessage")
  createdAt        DateTime            @default(now()) @map("createdat")
  updatedAt        DateTime?           @map("updatedat")
  files            BiUploadFile[]
  processingJob    BiProcessingJob?
  dashboards       BiDashboard[]
  analysisRequests BiAnalysisRequest[]
  biRequest        BiRequest?          @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@map("bi_uploads")
}

model BiUploadFile {
  id           String    @id @default(cuid())
  uploadId     String?   @map("uploadid")
  fileName     String?   @map("filename")
  rowCount     Int       @default(0) @map("rowcount")
  fileSize     Int       @default(0) @map("filesize")
  status       String    @default("PENDING")
  errorMessage String?   @map("errormessage")
  createdAt    DateTime  @default(now()) @map("createdat")
  upload       BiUpload? @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@map("bi_upload_files")
}

model BiProcessingJob {
  id            String            @id @default(cuid())
  uploadId      String?           @unique @map("uploadid")
  status        String            @default("QUEUED")
  startedAt     DateTime?         @map("startedat")
  completedAt   DateTime?         @map("completedat")
  errorMessage  String?           @map("errormessage")
  recordsLoaded Int               @default(0) @map("recordsloaded")
  createdAt     DateTime          @default(now()) @map("createdat")
  updatedAt     DateTime?         @map("updatedat")
  upload        BiUpload?         @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  logs          BiProcessingLog[]

  @@map("bi_processing_jobs")
}

model BiProcessingLog {
  id        String           @id @default(cuid())
  jobId     String?          @map("jobid")
  level     String           @default("INFO")
  step      String
  message   String
  details   Json?
  createdAt DateTime         @default(now()) @map("createdat")
  job       BiProcessingJob? @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("bi_processing_logs")
}

