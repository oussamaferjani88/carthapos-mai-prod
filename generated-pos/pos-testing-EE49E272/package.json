{
  "name": "carthapos-testing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "public/electron-modular.cjs",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode production",
    "build:safe": "vite build --mode production",
    "lint": "eslint .",
    "preview": "vite preview",
    "clean": "rimraf dist release node_modules/.cache",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron public/electron-modular.cjs\"",
    "debug-electron": "node debug-electron.js",
    "package": "npm run build:safe && electron-builder",
    "build:electron": "npm run build:safe && electron-builder",
    "build:win": "npm run build:safe && electron-builder --win",
    "build:mac": "npm run build:safe && electron-builder --mac",
    "build:linux": "npm run build:safe && electron-builder --linux",
    "build:docker-win": "npm run build:safe && electron-builder --win --x64"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-accordion": "^1.2.10",
    "@radix-ui/react-alert-dialog": "^1.1.13",
    "@radix-ui/react-aspect-ratio": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.9",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-collapsible": "^1.1.10",
    "@radix-ui/react-context-menu": "^2.2.14",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-hover-card": "^1.1.13",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-menubar": "^1.1.14",
    "@radix-ui/react-navigation-menu": "^1.2.12",
    "@radix-ui/react-popover": "^1.1.13",
    "@radix-ui/react-progress": "^1.1.6",
    "@radix-ui/react-radio-group": "^1.3.6",
    "@radix-ui/react-scroll-area": "^1.2.8",
    "@radix-ui/react-select": "^2.2.4",
    "@radix-ui/react-separator": "^1.1.6",
    "@radix-ui/react-slider": "^1.3.4",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-switch": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.11",
    "@radix-ui/react-toggle": "^1.1.8",
    "@radix-ui/react-toggle-group": "^1.1.9",
    "@radix-ui/react-tooltip": "^1.2.6",
    "@tailwindcss/vite": "^4.1.7",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "date-fns": "^2.29.3",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.15.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.510.0",
    "next-themes": "^0.4.6",
    "react": "^18.2.0",
    "react-day-picker": "8.10.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.56.3",
    "react-resizable-panels": "^3.0.2",
    "react-router-dom": "^7.6.1",
    "recharts": "^2.15.3",
    "sonner": "^2.0.3",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.7",
    "vaul": "^1.1.2",
    "wait-on": "^8.0.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@eslint/js": "^9.25.0",
    "@tailwindcss/postcss": "^4.1.15",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.20",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "terser": "^5.46.0",
    "tw-animate-css": "^1.2.9",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.carthapos.testing",
    "productName": "testing",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "public/electron-modular.cjs",
      "public/preload.js",
      "public/app-config.json",
      "public/favicon.ico",
      "resources/**/*",
      "src/electron/**/*",
      "node_modules/sqlite3/**/*",
      "node_modules/crypto-js/**/*",
      "node_modules/bcryptjs/**/*",
      "!node_modules/node-gyp/**/*",
      "!node_modules/@electron/rebuild/**/*",
      "!node_modules/**/test/**/*",
      "!node_modules/**/tests/**/*",
      "!node_modules/**/*.md",
      "!node_modules/**/*.txt"
    ],
    "asarUnpack": [
      "src/electron/**/*",
      "public/preload.cjs",
      "dist/app-config.json",
      "dist/favicon.ico",
      "dist/favicon.svg",
      "**/*.node"
    ],
    "extraFiles": [
      {
        "from": "node_modules/electron/dist/icudtl.dat",
        "to": "icudtl.dat"
      }
    ],
    "compression": "normal",
    "mac": {
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "carthapos-testing-Setup-${version}.${ext}",
      "requestedExecutionLevel": "requireAdministrator",
      "publish": null,
      "forceCodeSigning": false,
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CarthaPos-testing",
      "runAfterFinish": true,
      "allowElevation": true,
      "installerLanguages": [
        "en",
        "fr"
      ],
      "language": "2057",
      "warningsAsErrors": false,
      "installerHeaderIcon": null,
      "installerIcon": null,
      "uninstallerIcon": null,
      "installerSidebar": null,
      "uninstallerSidebar": null,
      "include": "nsis-installer.nsh"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "description": "POS System for Oussama - restaurant"
}